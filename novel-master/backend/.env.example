# Novel Master — Production Environment Variables
# Copy to .env and fill in real values before docker-compose up

# =============================================================================
# CRITICAL: Generate with: openssl rand -hex 32
# =============================================================================
SECRET_KEY=your-64-char-hex-secret-key-here-change-immediately

# Flask environment: production | development
FLASK_ENV=production

# CORS origins (comma-separated). Include your EC2 IP and domain.
ALLOWED_ORIGINS=http://YOUR-EC2-IP,https://yourdomain.com

# Database path inside container
DB_PATH=/app/continuity/novel_master.db

# Storage root inside container
STORAGE_ROOT=/app/storage

# JWT token expiry
JWT_EXPIRY_DAYS=7

# Redis URL (uses Docker service name 'redis' inside compose network)
REDIS_URL=redis://redis:6379/0

# Optional: AWS S3 (uncomment when ready)
# S3_BUCKET=your-novelmaster-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
